# Copy to .env.local and fill in. Never commit real values.

# Public base URL used to build share links (no trailing slash).
# Optional locally (defaults to http://localhost:3000) and on Vercel
# (falls back to the Vercel deployment / production domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL — Project Settings → Data API → Project URL.
# Base URL only: https://<ref>.supabase.co (no /rest/v1/).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase secret key — Project Settings → API Keys → Secret key (sb_secret_…),
# or the legacy service_role key.
# SERVER-ONLY SECRET: never prefix with NEXT_PUBLIC_, never use in client code.
SUPABASE_SERVICE_ROLE_KEY=
